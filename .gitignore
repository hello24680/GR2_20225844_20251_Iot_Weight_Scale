# ============================================
# ROOT .gitignore for Smart Scale IoT Project
# ============================================

# ===== Environment Variables =====
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ===== Node.js (Backend & Frontend) =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ===== Build Output =====
dist/
dist-ssr/
build/
out/
*.local

# ===== Frontend Specific (Vite/React) =====
.vite/
.cache/
.parcel-cache/

# ===== Backend Specific =====
logs/
*.log

# ===== Database =====
*.db
*.sqlite
*.sqlite3

# ===== PlatformIO (ESP32) =====
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ===== Testing & Coverage =====
coverage/
.nyc_output/
*.lcov

# ===== OS Files =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ===== IDE & Editor =====
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== Temporary Files =====
*.tmp
*.temp
*.bak
*.backup
*~.nib

# ===== Documentation Build =====
docs/_build/
docs/.vuepress/dist/

# ===== Project Specific =====
# Prisma
prisma/migrations/**/*.sql
!prisma/migrations/**/*_migration.sql

# Keep these files
!.gitignore
!.gitkeep
!.env.example
